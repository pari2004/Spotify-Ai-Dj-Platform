# Copy this file to `.env` and adjust. NEVER commit the real .env (see §10.1 / §14.2).

# JWT signing key — MUST be overridden in any real deployment.
JWT_SECRET_KEY=dev-only-change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_MINUTES=10080

# Database. Default is a local SQLite file (zero-config). To use Postgres instead,
# set e.g. postgresql+psycopg://user:pass@localhost:5432/djstudio
DATABASE_URL=sqlite:///./dj_studio.db

# AI DJ generation backend. "local" = deterministic template+retrieval generator
# (no network, fully offline, grounded). "openai"/"anthropic" = optional hosted LLM.
AI_BACKEND=local
# AI_API_KEY=   # only needed if AI_BACKEND != local

# CORS origins for the React dev client
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
